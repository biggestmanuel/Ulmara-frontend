{
  "expo": {
    "name": "Avora",
    "slug": "avora-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "avora",
    "ios": {
      "bundleIdentifier": "com.biggestmanuel.avora",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ulmara uses Face ID to unlock your wallet on this device. Your PIN still authorises every transfer, and no biometric data is stored or sent."
      }
    },
    "android": {
      "package": "com.biggestmanuel.avora",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#4A2D5C",
          "defaultChannel": "transactions"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ulmara uses Face ID to unlock your wallet on this device. Your PIN still authorises every transfer, and no biometric data is stored or sent."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Avora to save transaction receipts to your photos.",
          "savePhotosPermission": "Allow Avora to save transaction receipts to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9463f0a-8b25-47e6-bdc4-805a76cf50eb"
      }
    }
  }
}
