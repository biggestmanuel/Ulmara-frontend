# ---------------------------------------------------------------------------
# Ulmara frontend environment
#
# Every EXPO_PUBLIC_* value is inlined into the JS bundle at build time and is
# therefore PUBLIC. Never put a private key, mnemonic, or TriVerify credential
# here — those belong on the backend only.
# ---------------------------------------------------------------------------

# --- API --------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# --- EVM networks -----------------------------------------------------------
#
# The RPC URL and the chain id MUST agree with each other AND with the
# backend's ETHEREUM_CHAIN_ID / BSC_CHAIN_ID / BASE_CHAIN_ID /
# POLYGON_CHAIN_ID. If they disagree, every signed transaction is rejected by
# the network with an opaque error. The app checks this at runtime and reports
# a configuration problem rather than letting the transfer fail silently.
#
# Backend pilot phase uses Ethereum Sepolia (11155111). At mainnet go-live set
# EXPO_PUBLIC_ETHEREUM_CHAIN_ID=1 and point the RPC at a mainnet endpoint.
#
# Note: `https://rpc.sepolia.org` is NOT usable — it returns 404. Use a
# dedicated public endpoint such as the one below.
EXPO_PUBLIC_ETHEREUM_CHAIN_ID=11155111
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EXPO_PUBLIC_ETH_RPC_URL=
# Mainnet only. Leave empty while the backend is on Sepolia, or the app will
# sign Sepolia chain ids against a mainnet node.
EXPO_PUBLIC_RPC_ETH=

EXPO_PUBLIC_BSC_CHAIN_ID=56
EXPO_PUBLIC_BSC_RPC_URL=
EXPO_PUBLIC_RPC_BSC=https://bsc-rpc.publicnode.com

EXPO_PUBLIC_BASE_CHAIN_ID=8453
EXPO_PUBLIC_BASE_RPC_URL=
EXPO_PUBLIC_RPC_BASE=https://base-rpc.publicnode.com

EXPO_PUBLIC_POLYGON_CHAIN_ID=137
EXPO_PUBLIC_POLYGON_RPC_URL=
EXPO_PUBLIC_RPC_POLYGON=https://polygon-bor-rpc.publicnode.com

# Optional: override every EVM RPC at once.
# EXPO_PUBLIC_RPC_URLS={"ETH":"https://…","BSC":"https://…"}

# --- Non-EVM networks -------------------------------------------------------
EXPO_PUBLIC_RPC_SOL=https://api.mainnet-beta.solana.com
EXPO_PUBLIC_RPC_TRON=https://api.trongrid.io
EXPO_PUBLIC_RPC_TON=https://toncenter.com/api/v2/jsonRPC

# --- ERC-20 token support ---------------------------------------------------
#
# USDT and USDC are only shown in the app for networks where you supply a real
# contract address. A mainnet address on a testnet points at no contract, so
# every transfer would revert — the app hides a token that has no address
# configured for the selected network rather than offering a broken transfer.
#
# The mainnet deployments below are already built in (see constants/tokens.ts).
# You only need this variable for testnets, or to add a token contract that is
# not in the built-in list. Keys are "<SYMBOL>:<CHAIN>" with CHAIN uppercase.
#
# Sepolia has no canonical USDT or USDC. Deploy your own test token and put its
# address here:
#   npx hardhat node            # or your own EVM
#   # then, for example:
#   EXPO_PUBLIC_TOKEN_ADDRESSES={"USDC:ETH":"0xYourSepoliaUSDCAddress"}
EXPO_PUBLIC_TOKEN_ADDRESSES=

# --- Push notifications -----------------------------------------------------
#
# Base path the app POSTs/DELETEs an Expo push token to. The backend does not
# implement this route yet; until it does, registration reports
# "backend-pending" in Settings > Notifications and no pushes are delivered.
# See README "Push notifications" for the contract.
EXPO_PUBLIC_PUSH_TOKEN_PATH=/api/push/token

# Optional: route token balance reads through the backend instead of direct RPC.
# Falls back to direct `eth_call` reads when the route is absent.
EXPO_PUBLIC_TOKEN_BALANCES_PATH=/api/wallet/token-balances

# --- Pricing ----------------------------------------------------------------
# CoinGecko demo key. Prices are cosmetic (portfolio total); a missing key only
# affects the home-screen valuation.
EXPO_PUBLIC_COINGECKO_API_KEY=

# --- Ramp providers ---------------------------------------------------------
# Every ramp provider is called by the backend through /api/ramp/*. No provider
# credential belongs in the app bundle, so there is nothing to fill in here.
#
# (The Paystack and Flutterwave keys below are also unused: no client module
# reads them. They are left in place as out-of-scope for this change; see the
# report's "found but intentionally unfixed".)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- TriVerify --------------------------------------------------------------
# Configured on the backend validation proxy only. Credentials must never be
# bundled into the mobile app: the app calls POST /api/validation/address.

# Gas abstraction / fee sponsor wallet is backend-only, never EXPO_PUBLIC.
