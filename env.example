# API
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Chain RPC endpoints
# The EVM signer reads EXPO_PUBLIC_SEPOLIA_RPC_URL / EXPO_PUBLIC_ETH_RPC_URL
# and signs Sepolia (chainId 11155111) during the pilot phase.
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
EXPO_PUBLIC_ETH_RPC_URL=
EXPO_PUBLIC_RPC_ETH=
EXPO_PUBLIC_RPC_BSC=
EXPO_PUBLIC_RPC_BASE=
EXPO_PUBLIC_RPC_POLYGON=
EXPO_PUBLIC_RPC_SOL=
EXPO_PUBLIC_RPC_TRON=
EXPO_PUBLIC_RPC_TON=

# TriVerify is configured on the backend validation proxy.

# Bachs (NGN on/off-ramp) — scoped to deposits/withdrawals only
EXPO_PUBLIC_BACHS_API_KEY=
EXPO_PUBLIC_BACHS_ENV=sandbox

# Fallback ramp providers
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Gas abstraction / fee sponsor wallet (backend-only, not EXPO_PUBLIC)
GAS_SPONSOR_PRIVATE_KEY=
